---
import { render } from "astro:content";

const rawdoc = "---\ntitle: Doc MDX\ndescription: Doc MDX Test File\n---\n# Doc \nH1 Title\n## Doc H2 Title\nDoc Text\n"
const rendered = await render(rawdoc);
---

<!-- Wrap the component elements in our custom element “astro-heart”. -->
<live-doc>
    <table>
        <tbody>
            <tr>
                <td>Name:</td>
                <td id="randomuser"></td>
                <td id="update"><button type="button">Update</button></td>
            </tr>
            <tr>
                <td id="docbody">{rendered}</td>
            </tr>
        </tbody>
    </table>
</live-doc>
<script>

    // Define the behaviour for our new type of HTML element.
    class LiveDoc extends HTMLElement {
        constructor() {
            super();
        }
        // constructor() {
        //     super();
        // }
        async connectedCallback() {
            const docPlaceholder = this.querySelector('td#randomuser');
            const updateButton = this.querySelector('td#update');
            const docbody = this.querySelector('td#docbody');

            const response = await fetch('https://randomuser.me/api/');
            const data = await response.json();
            const { name } = data.results[0];
            docPlaceholder.textContent = name.title + name.first + name.last;
            // const refdoc = await fetch('http://localhost:4321/en/doc/');
            // const rd = await refdoc.text();
            // docbody.innerHTML = {render(`${rd}`)};
            // docbody.innerHTML = {rendered};
        
            updateButton.addEventListener('click', async () => {
                const res = await fetch('https://randomuser.me/api/');
                const jd = await res.json();
                const val = jd.results[0].name;
                docPlaceholder.textContent = val.title + val.first + val.last;
            });
        }

    }
  
    // Tell the browser to use our AstroHeart class for <astro-heart> elements.
    customElements.define('live-doc', LiveDoc);
  </script>