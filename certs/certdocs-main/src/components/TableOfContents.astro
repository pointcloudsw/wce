---
// import type { Props } from '@astrojs/starlight/props';
import TableOfContentsList from 'node_modules/@astrojs/starlight/components/TableOfContents/TableOfContentsList.astro';

// const { title } = Astro.props.entry.data;
// const { toc } = Astro.props;

// if ( [...(toc?.items ?? [])].length > 0 ) {
// 	[...toc.items][0].text = title;
// }

const title = Astro.locals.starlightRoute.entry.data.title;
const toc = Astro.locals.starlightRoute.toc;

if ( [...(Astro.locals.starlightRoute.toc?.items ?? [])].length > 0)
	Astro.locals.starlightRoute.toc.items[0].text = title;


---

{
	toc && (
		<starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page">
				<h2 id="starlight__on-this-page">
					{Astro.locals.t('tableOfContents.onThisPage')}
				</h2>
				<TableOfContentsList toc={toc.items} />
			</nav>
		</starlight-toc>
	)
}
<script src="../../node_modules/@astrojs/starlight/components/TableOfContents/starlight-toc"></script>